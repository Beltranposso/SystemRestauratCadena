# Copia este archivo como .env (en esta misma carpeta apps/api)
NODE_ENV=development
PORT=4000

# Coincide con docker-compose.yml
DATABASE_URL=postgresql://admin:admin@localhost:5432/restaurantes

# Cambia estos secretos (mínimo 32 caracteres). Ej: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambia-este-secreto-de-acceso-por-uno-largo-y-aleatorio
JWT_REFRESH_SECRET=cambia-este-secreto-de-refresh-por-otro-largo-y-aleatorio
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Origen del frontend (Vite). Varios separados por coma.
CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=info

# Días de pedidos sintéticos que genera el seed (más días = seed más lento)
SEED_DIAS_PEDIDOS=90

# Carpeta de fotos de productos (relativa a apps/api o ruta absoluta)
UPLOADS_DIR=uploads
